<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon foreground.

  The canvas is 108×108 but the launcher masks and animates it, so everything meaningful sits inside
  the middle 72×72 safe zone (18..90). The mark is the app's own subject matter: a trend line with
  its latest point called out.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M34,74 L48,58 L60,64 L74,42"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <path
        android:pathData="M74,42 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0"
        android:fillColor="#FFFFFFFF" />
</vector>
