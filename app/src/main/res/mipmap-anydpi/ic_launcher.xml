<?xml version="1.0" encoding="utf-8"?>
<!--
  `anydpi` rather than `anydpi-v26`: adaptive icons arrived in API 26 and this app's minSdk is well
  past that, so a version qualifier would only be noise.

  The monochrome layer is what themed icons use: the system tints it, so it has to be the shape alone
  with no colour of its own — the same mark as the foreground, which is already a white silhouette.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
